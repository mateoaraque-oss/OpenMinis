<?xml version="1.0" encoding="utf-8"?>
<!--
  [T-orion-icon] Adaptive-icon background for Orion.

  A deep indigo well with a faint violet bloom in the upper left, matching
  the orb's core gradient. Drawn as a vector so it scales to every density
  without shipping another five PNGs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="34"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#FF241650" />
                <item android:offset="0.45" android:color="#FF120C2B" />
                <item android:offset="1" android:color="#FF05030D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
