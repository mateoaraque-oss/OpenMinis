<?xml version="1.0" encoding="utf-8"?>
<!--
  [T-orion-icon] Adaptive-icon foreground: Orion's orb, flattened to vector.

  Everything here is the runtime orb's shape language — glow, two
  counter-rotating arcs, a lit sphere, a few particles — scaled into the
  66dp safe zone so no launcher mask can clip it.

  If you change the orb's palette in OrionOrb.kt, change these four colours
  with it: the launcher icon and the in-app sphere should read as the same
  object.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow. -->
    <path android:pathData="M54,23 A31,31 0 1 0 54,85 A31,31 0 1 0 54,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="31">
                <item android:offset="0" android:color="#667C6CFF" />
                <item android:offset="0.55" android:color="#3300D9C0" />
                <item android:offset="1" android:color="#0000D9C0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbiting ring, violet. -->
    <path
        android:pathData="M28.6,44.8 A27,27 0 0 1 74.7,36.6"
        android:strokeColor="#B37C6CFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- Orbiting ring, teal. -->
    <path
        android:pathData="M74.4,63.5 A22.5,22.5 0 0 1 35.6,66.9"
        android:strokeColor="#A600D9C0"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- The sphere, lit from the upper left. -->
    <path android:pathData="M38,54 A16,16 0 1 0 70,54 A16,16 0 1 0 38,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="49"
                android:centerY="47"
                android:gradientRadius="25">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.30" android:color="#FF8E7BFF" />
                <item android:offset="0.72" android:color="#FF3A2470" />
                <item android:offset="1" android:color="#FF120A2A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rim light, lower right. -->
    <path
        android:pathData="M58.5,68.4 A16,16 0 0 0 69.2,58.6"
        android:strokeColor="#CC00D9C0"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />

    <!-- Particles. -->
    <path
        android:pathData="M63.2,72.6 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#E600D9C0" />
    <path
        android:pathData="M44.8,28.6 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0"
        android:fillColor="#CC7C6CFF" />
    <path
        android:pathData="M79.4,44.8 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0"
        android:fillColor="#B300D9C0" />

    <!-- Centre spark. -->
    <path
        android:pathData="M54,50.5 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"
        android:fillColor="#E6FFFFFF" />
</vector>
